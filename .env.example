# =============================================================                                                                                                                                                                                               
# PG System 환경변수 설정 파일                                                                                                                                                                                                                                
# 이 파일을 복사해서 .env 파일로 만들고 값을 채워주세요                                                                                                                                                                                                       
# cp .env.example .env                                                                                                                                                                                                                                        
# =============================================================                                                                                                                                                                                               

# ----------------------------
# PostgreSQL DB 설정
# ----------------------------
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=your-secure-db-password-here
POSTGRES_DB=pgdb

# ----------------------------
# NestJS API 설정
# ----------------------------
NODE_ENV=development
API_PORT=4000

# DATABASE_URL은 위 DB 설정과 일치해야 합니다
DATABASE_URL=postgresql://pgadmin:your-secure-db-password-here@db:5432/pgdb

# ----------------------------
# JWT 시크릿 (openssl rand -hex 32 로 생성)
# ----------------------------
JWT_ACCESS_SECRET=여기에-64자리-hex-값-입력
JWT_REFRESH_SECRET=여기에-64자리-hex-값-입력
# MFA 전용 JWT 시크릿 — MFA 임시 토큰 서명용 (PCI DSS 8.4.2)
JWT_MFA_SECRET=여기에-64자리-hex-값-입력

# ----------------------------
# 암호화 키 (AES-256-GCM, openssl rand -hex 32 로 생성)
# ----------------------------
ENCRYPTION_KEY=여기에-64자리-hex-값-입력
# MFA TOTP 시크릿 암호화 전용 키 — 반드시 ENCRYPTION_KEY와 다른 값 사용 (PCI DSS 3.5.1)
MFA_ENCRYPTION_KEY=여기에-64자리-hex-값-입력

# ----------------------------
# Web 프론트엔드 (서버 전용)
# ----------------------------
# PG Gateway API URL — 서버 컴포넌트에서만 사용 (브라우저 노출 금지)
PG_API_URL=http://localhost:4000

# ----------------------------
# Grafana 모니터링 (선택사항)
# ----------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# ----------------------------
# 알림 채널 (선택사항 - Step 12-2 알림 기능)
# ----------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_EMAIL_USER=alerts@yourdomain.com
# ALERT_EMAIL_PASS=your-email-app-password
# ALERT_EMAIL_TO=admin@yourdomain.com

# ----------------------------
# Metrics 엔드포인트 접근 제한 (쉼표 구분 IP 목록)
# 미설정 시 localhost(127.0.0.1, ::1)만 허용
# ----------------------------
# METRICS_ALLOWED_IPS=127.0.0.1,::1,10.0.0.50

# ----------------------------
# VAN 프로바이더 설정 (Sprint A.3)
# MOCK(기본) | NICE | KIS | KICC
# ----------------------------
VAN_PROVIDER=MOCK
# NICE_VAN_API_URL=
# NICE_MERCHANT_CODE=
# KIS_VAN_API_URL=
# KIS_MERCHANT_CODE=